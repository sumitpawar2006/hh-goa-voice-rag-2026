# App
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
MAX_QUERY_CHARS=1000
MAX_AUDIO_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=30

# Required for live speech-to-text (ElevenLabs Scribe v2)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Dataset / chunking
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_LANGUAGE=hi
DATASET_SPLIT=validation
DATASET_SAMPLE_SIZE=500
CHUNKING_STRATEGY=semantic
CHUNK_SIZE=180
CHUNK_OVERLAP=36

# Embeddings / Qdrant
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
PREWARM_EMBEDDINGS=true
QDRANT_PATH=rag/data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi
TOP_K=5
CANDIDATE_K=12
MIN_RELEVANCE_SCORE=0.50
RERANKER_MODE=lexical

# Answer generation. extractive is fully grounded and key-free; llama_cpp is a local LLM.
GENERATOR_PROVIDER=extractive
LLM_SERVER_URL=http://127.0.0.1:8080/v1
LLM_MODEL_PATH=rag/data/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.1
